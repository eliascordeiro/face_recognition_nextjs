# Fornecido automaticamente pelo Railway ao adicionar o addon PostgreSQL
DATABASE_URL=postgresql://user:password@host:5432/railway

# Segredo para assinar tokens JWT — use uma string longa e aleatória
JWT_SECRET=mude-este-segredo-antes-de-usar-em-producao

# Admin padrão criado na primeira inicialização
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Opcional: token da Mapbox Geocoding API — usado como provedor principal de
# geocodificação (CEP/GPS ↔ endereço), com cobertura de números de porta bem
# mais completa que o OpenStreetMap no Brasil. Sem essa variável, o sistema
# usa automaticamente o Nominatim/OpenStreetMap (gratuito) como fallback.
# Crie em https://account.mapbox.com/access-tokens/
MAPBOX_TOKEN=
